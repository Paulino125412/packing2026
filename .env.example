# ENVIRONMENT VARIABLES EXAMPLE (.env.example)

# Puerto de ejecución del servidor Node / Express (por defecto 3000)
PORT=3000

# Entorno de ejecución ('development' o 'production')
NODE_ENV=production

# Token opcional para integración de consulta RUC/DNI externa (Decolecta)
DECOLECTA_API_TOKEN=tu_token_decolecta_aqui

# DSN de Sentry para reporte de errores del cliente y servidor
VITE_SENTRY_DSN=https://tu_public_dsn@o0.ingest.sentry.io/0

# ==============================================================================
# CONFIGURACIÓN DE CREDENCIALES DE GOOGLE CLOUD / FIREBASE ADMIN SDK
# ==============================================================================
# En entornos locales o servidores externos fuera de Google Cloud, define la ruta 
# absoluta al archivo JSON de la clave de cuenta de servicio de Firebase Admin:
# GOOGLE_APPLICATION_CREDENTIALS=/app/config/firebase-service-account.json
#
# Nota en Google Cloud Run:
# Cuando la aplicación se despliega en Google Cloud Run, este parámetro NO es
# necesario si la Service Account adjunta al servicio Cloud Run cuenta con los
# roles mínimos necesarios (ver README.md). El SDK utilizará Application 
# Default Credentials (ADC) automáticamente.
