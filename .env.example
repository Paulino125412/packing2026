# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DECOLECTA_API_TOKEN: Optional token for Decolecta SUNAT/RENIEC lookup service.
DECOLECTA_API_TOKEN="TU_TOKEN_DE_DECOLECTA_AQUI"

# VITE_SENTRY_DSN: Sentry project DSN for error monitoring and session replay.
# Optional. If not provided, the Sentry tunnel endpoint returns HTTP 204 without forwarding events.
VITE_SENTRY_DSN=""
