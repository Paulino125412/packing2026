rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['currentValue']) &&
             data.currentValue is number &&
             data.currentValue >= 0;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /providers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /articles/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /clients/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /sellers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /inventory/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /packinglists/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /sales_orders/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /counters/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidCounter(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isAdmin() && !request.resource.data.keys().hasAny(['passwordHash', 'salt']);
      allow update: if isSignedIn() && (
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'salt'])) ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }
  }
}
